/PREP7
! timber material
mp,ex,1,13600.0
mp,ey,1,300.0
mp,ez,1,300.0
mp,prxy,1,0.35
mp,pryz,1,0.35
mp,prxz,1,0.35
mp,gxy,1,650.0
mp,gyz,1,65.0
mp,gxz,1,650.0

! timber failure: maximum stress criterion (EN 14080 characteristic values)
! tbdata: Xc, Xt, Yc, Yt, Zc, Zt, Sxy, Syz, Sxz  [MPa]
tb,fail,1,,,mxst
tbdata,1,30.0,24.0,2.5,0.5,2.5,0.5,3.5,3.5,3.5

! steel material
mp,ex,2,210000
mp,prxy,2,0.3

! steel plasticity: bilinear isotropic hardening (S355)
! tbdata: fy [MPa], tangent modulus Et=E/100 [MPa]
tb,biso,2
tbdata,1,355,2100

! element type: SOLID187 (10-node tet, better for curved geometry)
et,1,187

! timber beam volume
block,0,1000.0, 0,200.0, 0,140.0
*get,vid_beam,volu,0,num,max
cm,BEAM,volu,vid_beam
allsel,all

