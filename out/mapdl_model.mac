! ============================================================
! FRICTIONAL CONTACT - Augmented Lagrangian
! mat 3: steel-on-timber (mu=0.3)  mat 4: steel-on-steel (mu=0.15)
! 4 dowels x (1 beam pair + 1 plate pair(s)) = 8 real sets
! ============================================================
/prep7
allsel,all

! friction contact materials
mp,mu,3,0.3
mp,mu,4,0.15

et,2,targe170
et,3,conta174

! Augmented Lagrangian (keyopt 2=0): avoids MPC self-contact issue
keyopt,3,2,0
! Standard frictional contact (keyopt 12=0)
keyopt,3,12,0
! Ignore initial gap/penetration -> prevents initial offset errors
keyopt,3,9,1

r,1
r,2
r,3
r,4
r,5
r,6
r,7
r,8

